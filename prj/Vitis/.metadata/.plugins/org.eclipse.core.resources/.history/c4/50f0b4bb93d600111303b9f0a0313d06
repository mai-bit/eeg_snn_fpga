    1.366962405f, 1.323719444f, 1.279346043f, 1.233880095f,
    1.187360429f, 1.139826770f, 1.091319713f, 1.041880681f
};

static s16 sample_window[NWIN];
static float power_bins[NBANDS];
static u32 window_fill = 0U;
static u16 rd_seq = 0U;
static u32 samples_since_hop = 0U;

/* Read the low 16-bit producer counter. */
static u16 read_write_sequence(void)
{
    return (u16)(BRAM_READ(ADDR_PTR) & 0xFFFFU);
}

/* Print BRAM contents once at startup to locate a PL->BRAM->PS problem. */
static void print_bram_debug(void)
{
    u32 ptr;
    u32 i;

    xil_printf("\r\n--- BRAM DEBUG BEGIN ---\r\n");
    xil_printf("BRAM base = 0x%08x\r\n", (unsigned)EEG_BRAM_BASE);

    ptr = BRAM_READ(ADDR_PTR);
    xil_printf("Producer word[1280] = 0x%08x\r\n", (unsigned)ptr);
    xil_printf("Producer sequence   = %u\r\n",
               (unsigned)(ptr & 0xFFFFU));

    for (i = 0U; i < 16U; ++i) {
        u32 value = BRAM_READ(ADDR_RING_BASE + i);
        xil_printf("RAW[%02d] word[%u] = 0x%08x, signed=%d\r\n",
                   (int)i,
                   (unsigned)(ADDR_RING_BASE + i),
                   (unsigned)value,
                   (int)(s16)(value & 0xFFFFU));
    }

    xil_printf("Status word[1289] = 0x%08x\r\n",
               (unsigned)BRAM_READ(ADDR_STAT));

    for (i = 0U; i < 8U; ++i) {
        xil_printf("TGAM band[%u] = 0x%08x\r\n",
                   (unsigned)i,
                   (unsigned)BRAM_READ(ADDR_BAND0 + i));
    }

    xil_printf("--- BRAM DEBUG END ---\r\n\r\n");
}

/* Calculate 32 Goertzel powers for the current NWIN samples. */
static void calculate_goertzel(void)
{
    u32 b;
    u32 n;

    for (b = 0U; b < NBANDS; ++b) {
        float s1 = 0.0f;
        float s2 = 0.0f;

        for (n = 0U; n < NWIN; ++n) {
            float x = (float)sample_window[n];
            float s0 = x + goertzel_coeff[b] * s1 - s2;
            s2 = s1;
            s1 = s0;
        }

        /* coeff = 2*cos(omega); standard Goertzel power expression. */
        power_bins[b] =
            s1 * s1 + s2 * s2 - goertzel_coeff[b] * s1 * s2;

        if (power_bins[b] < 0.0f) {
            power_bins[b] = 0.0f;
        }
    }
}

/*
 * theta: 4..7 Hz  -> bins 0..3
 * alpha: 8..12 Hz -> bins 4..8
 * beta : 13..30 Hz -> bins 9..26
 */
static int calculate_band_scores(float score[3])
{
    u32 i;
    float total;

    score[0] = 0.0f;
    score[1] = 0.0f;
    score[2] = 0.0f;

    for (i = 0U; i <= 3U; ++i) {
        score[0] += power_bins[i];
    }
    for (i = 4U; i <= 8U; ++i) {
        score[1] += power_bins[i];
    }
    for (i = 9U; i <= 26U; ++i) {
        score[2] += power_bins[i];
    }

    total = score[0] + score[1] + score[2];
    if (total <= 0.0f) {
        return -1;
    }

    if ((score[0] >= score[1]) && (score[0] >= score[2])) {
        return 0;
    }
    if (score[1] >= score[2]) {
        return 1;
    }
    return 2;
}

/* Append a sample to the 430-sample rolling window. */
static void push_sample(s16 sample)
{
    u32 i;

    if (window_fill < NWIN) {
        sample_window[window_fill] = sample;
        ++window_fill;
    } else {
        for (i = 0U; i < (NWIN - 1U); ++i) {
            sample_window[i] = sample_window[i + 1U];
        }
        sample_window[NWIN - 1U] = sample;
    }
}

/* Print TGAM eSense and band-power words when status sequence changes. */
static void print_tgam_status(void)
{
    static int first = 1;
    static u8 last_status_seq = 0xFFU;

    u32 status = BRAM_READ(ADDR_STAT);
    u8 sequence = (u8)(status & 0xFFU);

    if (first || (sequence != last_status_seq)) {
        u32 band[8];
        u32 i;

        for (i = 0U; i < 8U; ++i) {
            band[i] = BRAM_READ(ADDR_BAND0 + i) & 0x00FFFFFFU;
        }

        /* Confirm status did not change while reading the band words. */
        if (BRAM_READ(ADDR_STAT) == status) {
            first = 0;
            last_status_seq = sequence;

            xil_printf("E,%u,%u,%u,%u",
                       (unsigned)((status >> 24) & 0xFFU),
                       (unsigned)((status >> 16) & 0xFFU),
                       (unsigned)((status >> 8) & 0xFFU),
                       (unsigned)sequence);

            for (i = 0U; i < 8U; ++i) {
                xil_printf(",%lu", (unsigned long)band[i]);
            }
            xil_printf("\r\n");
        }
    }
}

/* Process every sample that PL has produced since the last PS read. */
static void process_new_samples(void)
{
    u16 write_seq = read_write_sequence();
    u16 available = (u16)(write_seq - rd_seq);

    if (available > RING_SIZE) {
        xil_printf("#WARN,ring_overrun,available=%u\r\n",
                   (unsigned)available);
        rd_seq = (u16)(write_seq - RING_SIZE);
        available = (u16)RING_SIZE;
    }

    while (available > 0U) {
        u32 ring_index = ((u32)rd_seq) & RING_MASK;
        u32 raw_word = BRAM_READ(ADDR_RING_BASE + ring_index);
        s16 raw_sample = (s16)(raw_word & 0xFFFFU);

        push_sample(raw_sample);

        ++rd_seq;
        --available;
        ++samples_since_hop;
