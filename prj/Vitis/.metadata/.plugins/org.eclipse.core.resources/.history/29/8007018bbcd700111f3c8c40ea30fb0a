
#include "xparameters.h"
#include "xil_printf.h"
#include "xil_io.h"
#include "xil_cache.h"
#include "sleep.h"
#include "stdint.h"

// =====================================================
// BRAM 地址配置
// =====================================================

// 根据你的 Vivado Address Editor 配置
#define BRAM_BASE       0x40000000U

// BRAM word index
#define RAW_START       256U
#define RAW_END         1279U
#define PRODUCER_INDEX  1280U

// word index 转换为 byte address
#define BRAM_ADDR(index) (BRAM_BASE + ((uint32_t)(index) * 4U))

// =====================================================
// BRAM 读取函数
// =====================================================

static uint32_t bram_read(uint32_t word_index)
{
    uint32_t addr = BRAM_ADDR(word_index);

    // 使对应缓存行失效，避免读取到旧数据
    Xil_DCacheInvalidateRange(addr, 4U);

    // 通过 AXI BRAM Controller 读取 BRAM
    return Xil_In32(addr);
}

// =====================================================
// 主函数
// =====================================================

int main(void)
{
    uint32_t producer;
    uint32_t raw_value;

    xil_printf("\r\n");
    xil_printf("================================\r\n");
    xil_printf("       BRAM READ TEST\r\n");
    xil_printf("================================\r\n");

    xil_printf("BRAM BASE     = 0x%08lx\r\n",
               (unsigned long)BRAM_BASE);

    xil_printf("PRODUCER ADDR = 0x%08lx\r\n",
               (unsigned long)BRAM_ADDR(PRODUCER_INDEX));

    while (1)
    {
        // 读取 Producer
        producer = bram_read(PRODUCER_INDEX);

        // 读取 Raw[814]
        raw_value = bram_read(814U);

        xil_printf("--------------------------------\r\n");

        xil_printf("Raw[814] = 0x%08lx (%ld)\r\n",
                   (unsigned long)raw_value,
                   (long)(int32_t)raw_value);

        xil_printf("Producer = %lu\r\n",
                   (unsigned long)producer);

        // 等待 1 秒
        sleep(1);
    }

    return 0;
}
